<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Só para o ícone da bandeja (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Claudin</AssemblyName>
    <RootNamespace>Claudin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Claudin.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Claudin</Product>
    <Description>Alterna entre duas contas do Claude Desktop numa única janela.</Description>
    <!-- WFO0003 vale para apps WinForms; aqui o app é WPF e o DPI por monitor fica no manifesto (necessário para a Fase 3). -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Claudin.Tests" />
    <!-- Projetos WPF não importam System.IO implicitamente (conflito com Shapes.Path). -->
    <Using Include="System.IO" />
    <!-- WinForms entra só para a bandeja: sem usings globais, para não conflitar com os tipos do WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Claudin.ico" />
  </ItemGroup>

</Project>
