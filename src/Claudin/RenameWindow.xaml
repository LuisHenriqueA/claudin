<Window x:Class="Claudin.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renomear aba"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource HostBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="Nome da aba" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" AutomationProperties.Name="Nome da aba" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Salvar" Style="{StaticResource ActionButtonStyle}" IsDefault="True" Click="OnSaveClick" />
            <Button Content="Cancelar" Style="{StaticResource GhostButtonStyle}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
