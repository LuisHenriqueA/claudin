<Window x:Class="Claudin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Claudin"
        Title="Configurações do Claudin"
        Width="720" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource HostBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#00FFFFFF" BorderThickness="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Rodapé -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarBrush}" Padding="20,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Salvar" Style="{StaticResource ActionButtonStyle}" IsDefault="True" Click="OnSaveClick" />
                    <Button Content="Cancelar" Style="{StaticResource GhostButtonStyle}" IsCancel="True" Margin="0" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,6,24,24">

                <!-- Perfis -->
                <TextBlock Text="Perfis" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="ProfilesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ProfileEditViewModel}">
                            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="6" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Nome" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                             AutomationProperties.Name="{Binding NameLabel}" />

                                    <TextBlock Grid.Row="1" Text="Cor" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Ellipse Width="22" Height="22" Fill="{Binding PreviewBrush}" Margin="0,0,10,0" />
                                        <TextBox Width="96" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"
                                                 FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="{Binding ColorLabel}" />
                                        <ItemsControl ItemsSource="{Binding Presets}" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}"
                                                            ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}"
                                                            Command="{Binding Pick}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="{Binding FolderText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Pastas -->
                <TextBlock Text="Pastas dos perfis" Style="{StaticResource SectionTitle}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Procurar…" Style="{StaticResource GhostButtonStyle}" Padding="12,4"
                            Margin="8,0,0,0" Click="OnBrowseRootClick" />
                    <TextBox x:Name="RootBox" AutomationProperties.Name="Raiz das pastas dos perfis" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Perfis sem pasta própria usam &lt;raiz&gt;\&lt;id&gt;. A pasta padrão do Claude (perfil que recebe os links claude://) não muda. Vale depois de reiniciar o Claudin." />

                <!-- Claude Desktop -->
                <TextBlock Text="Claude Desktop" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="DetectedText" TextWrapping="Wrap" FontSize="12" />
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="Procurar…" Style="{StaticResource GhostButtonStyle}" Padding="12,4" Margin="0,0,6,0"
                                Click="OnBrowseClaudeClick" />
                        <Button Content="Automático" Style="{StaticResource GhostButtonStyle}" Padding="12,4" Margin="0"
                                Click="OnClearClaudeClick" />
                    </StackPanel>
                    <TextBox x:Name="ClaudePathBox" AutomationProperties.Name="Caminho personalizado do Claude" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Vazio = detecção automática (alias claude-desktop.exe ou pacote da Store). Vale depois de reiniciar o Claudin." />

                <!-- Comportamento -->
                <TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="StartWithWindowsBox" Content="Iniciar com o Windows (em segundo plano, na bandeja)" />
                <CheckBox x:Name="OpenActiveBox" Content="Abrir o perfil ativo quando o Claudin iniciar" />
                <CheckBox x:Name="CloseToTrayBox" Content="O X da janela mantém o Claudin na bandeja, em vez de sair" />
                <CheckBox x:Name="HideCaptionBox" Content="Esconder os botões de minimizar, maximizar e fechar do Claude (ficam só os do Claudin)" />
                <CheckBox x:Name="ProfileFrameBox" Content="Moldura na cor da conta ativa em volta do Claude" />
                <CheckBox x:Name="HideTaskbarBox" Content="Mostrar só o Claudin na barra de tarefas (sem o botão do Claude)" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Sem o botão do Claude, os avisos dele na barra de tarefas (contador e piscar) não aparecem, e no Alt+Tab fica só o Claudin. As notificações do Windows continuam." />
                <TextBlock Style="{StaticResource Hint}"
                           Text="O Claudin lembra o último perfil ativo e a posição e o tamanho da janela. Atalhos: Ctrl+Alt+1, Ctrl+Alt+2…" />

                <!-- Registro e protocolo -->
                <TextBlock Text="Registro do Windows" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0"
                           Text="O Claudin só altera a entrada de início com o Windows (HKCU\Software\Microsoft\Windows\CurrentVersion\Run), e salva o valor original antes. O protocolo claude:// não é alterado: o Windows o entrega ao pacote do Claude, e o assistente de login guia o código entre as contas." />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="RestoreRegistryButton" Content="Restaurar registro ao estado original"
                            Style="{StaticResource GhostButtonStyle}" Padding="12,4" Click="OnRestoreRegistryClick" />
                    <TextBlock x:Name="RestoreStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- Pastas do Claudin -->
                <TextBlock Text="Logs e configuração" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Abrir pasta de logs" Style="{StaticResource GhostButtonStyle}" Padding="12,4" Click="OnOpenLogsClick" />
                    <Button Content="Abrir pasta de configuração" Style="{StaticResource GhostButtonStyle}" Padding="12,4" Click="OnOpenConfigClick" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Os logs não guardam dados pessoais e são apagados depois de 14 dias (um arquivo por dia, até 5 MB cada)." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
