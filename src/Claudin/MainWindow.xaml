<Window x:Class="Claudin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Claudin"
        Title="Claudin"
        Width="1200" Height="780"
        MinWidth="660" MinHeight="470"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource HostBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- A barra de 36px é a própria barra de título (sem a legenda padrão do Windows). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="{StaticResource BarBrush}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="TransferButton" Style="{StaticResource CaptionButtonStyle}" FontSize="13"
                                Content="&#xE72D;" Click="OnTransferButtonClick" AutomationProperties.Name="Levar conversa para outra conta"
                                ToolTip="Levar a conversa aberta para outra conta (abre um chat novo lá, já com o contexto)." />
                        <Button x:Name="LoginButton" Style="{StaticResource CaptionButtonStyle}" FontSize="13"
                                Content="&#xE8D7;" Click="OnLoginButtonClick" AutomationProperties.Name="Assistente de login"
                                ToolTip="Assistente de login: ajuda a entrar numa conta no perfil ativo." />
                        <Button x:Name="SettingsButton" Style="{StaticResource CaptionButtonStyle}" FontSize="13"
                                Content="&#xE713;" Click="OnSettingsClick" AutomationProperties.Name="Configurações"
                                ToolTip="Configurações" />
                        <Rectangle Width="1" Margin="4,10" Fill="{StaticResource BorderBrush}" />
                        <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                                Click="OnMinimizeClick" ToolTip="Minimizar" AutomationProperties.Name="Minimizar" />
                        <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                                Click="OnMaxRestoreClick" ToolTip="Maximizar" AutomationProperties.Name="Maximizar" />
                        <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;"
                                Click="OnCloseClick" ToolTip="Fechar" AutomationProperties.Name="Fechar" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Claudin" Margin="14,0,10,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                        <ItemsControl x:Name="ProfileList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ProfileButtonViewModel}">
                                    <Button Style="{StaticResource ProfileButtonStyle}" Click="OnProfileClick"
                                            ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Renomear…" Click="OnRenameProfileClick" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Bolinha cheia = instância aberta; vazada = fechada. -->
                                            <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding ColorBrush}" Stroke="{Binding ColorBrush}" StrokeThickness="1.5" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Instance.IsAlive}" Value="False">
                                            <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Dot" Property="Stroke" Value="White" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsActive}" Value="True" />
                                                <Condition Binding="{Binding Instance.IsAlive}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Dot" Property="Fill" Value="White" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Instance.State}" Value="Starting">
                                            <Setter TargetName="Dot" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Faixa do assistente de login (Fase 4). Quando aparece, a área host encolhe e o Claude acompanha. -->
            <Border x:Name="LoginStrip" Grid.Row="1" Visibility="Collapsed" Background="#2B2A22"
                    BorderBrush="#5A4E2A" BorderThickness="0,0,0,1" Padding="14,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LoginPrimary" Style="{StaticResource ActionButtonStyle}" Padding="12,4"
                                Click="OnLoginPrimaryClick" />
                        <Button x:Name="LoginSecondary" Style="{StaticResource GhostButtonStyle}" Padding="12,4" Margin="0"
                                Click="OnLoginSecondaryClick" />
                    </StackPanel>
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D7;" FontSize="14" Margin="0,0,10,0"
                               VerticalAlignment="Center" Foreground="{StaticResource WarnBrush}" />
                    <TextBlock x:Name="LoginText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                               AutomationProperties.LiveSetting="Assertive" />
                </DockPanel>
            </Border>

            <!-- Faixa do "Levar conversa" (Fase 7). -->
            <Border x:Name="TransferStrip" Grid.Row="2" Visibility="Collapsed" Background="#1F2A33"
                    BorderBrush="#2E4A63" BorderThickness="0,0,0,1" Padding="14,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TransferPrimary" Style="{StaticResource ActionButtonStyle}" Padding="12,4"
                                Click="OnTransferPrimaryClick" />
                        <Button x:Name="TransferSecondary" Style="{StaticResource GhostButtonStyle}" Padding="12,4" Margin="0"
                                Click="OnTransferSecondaryClick" />
                    </StackPanel>
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72D;" FontSize="14" Margin="0,0,10,0"
                               VerticalAlignment="Center" Foreground="#7FB2FF" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TransferText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock x:Name="TransferHint" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Área host: a janela do Claude ativo é posicionada aqui (Fase 3). -->
            <Border x:Name="HostArea" Grid.Row="3" Background="{StaticResource HostBrush}">
                <!-- Escondido enquanto o Claude do perfil ativo está aberto: numa troca, o que aparece é só um fundo liso
                     na cor do Claude (HostArea), e não este cartão. -->
                <ScrollViewer x:Name="StatusPanel" VerticalScrollBarVisibility="Auto">
                    <Border MaxWidth="720" Margin="24" Padding="28,24" CornerRadius="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <!-- Estado da instância do perfil ativo -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StatusIcon" FontFamily="{StaticResource IconFont}" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock x:Name="StatusTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <TextBlock x:Name="StatusDetail" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="PrimaryAction" Style="{StaticResource ActionButtonStyle}" Click="OnPrimaryActionClick" />
                                <Button x:Name="SecondaryAction" Style="{StaticResource GhostButtonStyle}" Click="OnSecondaryActionClick" />
                            </StackPanel>
                            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Atalhos: Ctrl+Alt+1, Ctrl+Alt+2… alternam entre os perfis." />

                            <Rectangle Height="1" Margin="0,20" Fill="{StaticResource BorderBrush}" />

                            <!-- Diagnóstico -->
                            <TextBlock Text="Diagnóstico" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ClaudeIcon" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="ClaudeTitle" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ClaudePath" Margin="0,4,0,0" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                            <TextBlock x:Name="ClaudeDetail" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="NotesText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />

                            <ItemsControl x:Name="FolderList" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:FolderRowViewModel}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Fill="{Binding ColorBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Path}" TextWrapping="Wrap"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{Binding StatusBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="ConfigPathText" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11.5" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
